---
import { getSite } from "../lib/site";

interface Props {
  projectSlug?: string;
  dark?: boolean;
}

const { projectSlug, dark = false } = Astro.props;
const { apiBase } = getSite();
const field = dark
  ? "border-paper/25 placeholder:text-paper/50 text-paper w-full border-b bg-transparent py-3 outline-none focus:border-paper"
  : "border-line placeholder:text-stone text-ink w-full border-b bg-transparent py-3 outline-none focus:border-ink";
---

<form
  class="lead-form space-y-5"
  data-endpoint={`${apiBase}/public/leads`}
  data-project={projectSlug ?? ""}
  novalidate
>
  <div class="grid gap-5 md:grid-cols-2">
    <input class={field} name="name" placeholder="Nombre completo" autocomplete="name" required />
    <input class={field} name="phone" placeholder="Celular" inputmode="tel" autocomplete="tel" required />
  </div>
  <input class={field} name="email" type="email" placeholder="Correo (opcional)" autocomplete="email" />
  <textarea class={field} name="message" rows="2" placeholder="Cuéntanos qué buscas"></textarea>
  <label class:list={["flex items-start gap-3 text-xs", dark ? "text-paper/70" : "text-stone"]}>
    <input type="checkbox" name="consent" required class="mt-0.5" />
    Autorizo el tratamiento de mis datos personales para que me contacten.
  </label>
  <button type="submit" class:list={[dark ? "btn-light" : "btn-solid", "w-full md:w-auto"]}>
    Quiero que me contacten <span aria-hidden="true">→</span>
  </button>
  <p class="form-status text-sm" role="status" aria-live="polite"></p>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>(".lead-form")) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>(".form-status")!;
      const data = new FormData(form);
      if (!data.get("consent")) {
        status.textContent = "Necesitamos tu autorización para contactarte.";
        return;
      }
      const button = form.querySelector("button")!;
      button.disabled = true;
      status.textContent = "Enviando…";
      try {
        const res = await fetch(form.dataset.endpoint!, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            name: data.get("name"),
            phone: data.get("phone"),
            email: data.get("email") || undefined,
            message: data.get("message") || undefined,
            projectSlug: form.dataset.project || undefined,
            consent: true,
          }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = "¡Gracias! Te contactaremos muy pronto.";
      } catch {
        status.textContent = "No pudimos enviar tus datos. Revisa el celular e inténtalo de nuevo.";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
