---
interface Stat {
  value: number;
  label: string;
  format?: "number" | "cop";
  suffix?: string;
  prefix?: string;
}

interface Props {
  stats: Stat[];
  dark?: boolean;
}

const { stats, dark = false } = Astro.props;
---

<dl class:list={["grid gap-px overflow-hidden rounded-3xl", dark ? "bg-paper/15" : "bg-line", stats.length > 3 ? "md:grid-cols-4" : "md:grid-cols-3", "grid-cols-2"]}>
  {
    stats.map((stat, i) => (
      <div class:list={["flex flex-col justify-between gap-6 p-6 md:p-8", dark ? "bg-ink" : "bg-paper"]} data-reveal="up" data-delay={i * 120}>
        <dt class:list={["kicker", dark && "!text-paper/60"]}>{stat.label}</dt>
        <dd class:list={["font-display tabular-nums", stat.format === "cop" ? "text-2xl md:text-3xl xl:text-4xl" : "text-4xl md:text-5xl"]}>
          {stat.prefix}
          <span data-count={stat.value} data-format={stat.format ?? "number"}>
            0
          </span>
          {stat.suffix}
        </dd>
      </div>
    ))
  }
</dl>
