---
import Base from "../layouts/Base.astro";
---

<Base title="Página no encontrada">
  <section class="mx-auto max-w-3xl px-5 py-24 text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="text-hero text-graphite mt-4 font-extrabold">No encontramos esta página</h1>
    <p class="text-iron mt-4">Puede que el proyecto ya no esté disponible.</p>
    <a href="/#proyectos" class="btn-brand mt-8">Ver proyectos</a>
  </section>
</Base>
