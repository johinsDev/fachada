---
import { cities, getSite } from "../lib/site";

const { company, projects } = getSite();
const year = new Date().getFullYear();
---

<footer id="contacto" class="bg-graphite mt-24 text-white">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 md:grid-cols-3">
    <div>
      <p class="text-xl font-extrabold">{company.name}</p>
      <p class="mt-3 max-w-xs text-sm text-white/70">
        Construimos vivienda pensada para quedarse. Escríbenos y te acompañamos en la compra.
      </p>
    </div>
    <div>
      <p class="text-label font-semibold tracking-[0.14em] text-white/60 uppercase">Proyectos</p>
      <ul class="mt-4 space-y-2 text-sm">
        {
          cities(projects).map((city) => (
            <li>
              <a class="text-white/80 hover:text-white" href={`/?ciudad=${encodeURIComponent(city)}#proyectos`}>
                {city}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="text-label font-semibold tracking-[0.14em] text-white/60 uppercase">Contacto</p>
      {company.whatsapp && <p class="mt-4 text-sm text-white/80">WhatsApp {company.whatsapp}</p>}
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="mx-auto max-w-7xl px-5 py-6 text-xs text-white/50">
      © {year} {company.name}. Sitio creado con Fachada.
    </p>
  </div>
</footer>
