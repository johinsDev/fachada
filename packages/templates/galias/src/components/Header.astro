---
import { getSite } from "../lib/site";

const { company } = getSite();
---

<header class="border-mist sticky top-0 z-30 border-b bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-[78px] max-w-7xl items-center justify-between gap-6 px-5">
    <a href="/" class="flex items-center gap-3" aria-label={`${company.name}, inicio`}>
      {
        company.logoUrl ? (
          <img src={company.logoUrl} alt={company.name} class="h-8 w-auto" />
        ) : (
          <span class="text-graphite text-lg font-extrabold tracking-tight">
            <span class="bg-brand mr-2 inline-block size-3 rounded-full align-middle" />
            {company.name}
          </span>
        )
      }
    </a>
    <nav class="flex items-center gap-6 text-sm font-medium">
      <a href="/#proyectos" class="text-iron hover:text-graphite hidden sm:inline">Proyectos</a>
      <a href="/#contacto" class="btn-brand !px-5 !py-2.5">Contáctanos</a>
    </nav>
  </div>
</header>
