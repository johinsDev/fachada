{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fachada-api",
  "main": "src/index.ts",
  "account_id": "9fe45bafe8be5dd315f8164b97ff9399",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "ROOT_DOMAIN": "fachada.dev" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fachada",
      "database_id": "ba7d7794-4d0a-42da-8405-5b04894a78b9",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "fachada-media" },
    { "binding": "SITES", "bucket_name": "fachada-sites" },
  ],
  "containers": [
    {
      "class_name": "SiteSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "site": { "dockerfile": "../../sandbox/Dockerfile", "build_context": "../.." },
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "SiteSandbox", "name": "SANDBOX" },
      { "class_name": "BuildCoordinator", "name": "BUILDS" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteSandbox", "BuildCoordinator"] }],
  // api.* and app-less hosts: the API, the tenant sites (<slug>.) and the previews (p-<slug>.).
  "routes": [
    { "pattern": "api.fachada.dev/*", "zone_name": "fachada.dev" },
    { "pattern": "*.fachada.dev/*", "zone_name": "fachada.dev" },
    { "pattern": "fachada.dev/*", "zone_name": "fachada.dev" },
  ],
}
